# Neon pooled connection for the Next.js application runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&schema=public
# Neon direct connection for Prisma migrations, seeding, and other CLI commands.
# Use the same branch/database credentials without the "-pooler" hostname suffix.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&schema=public

AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Google OAuth Web application credentials. Keep the client secret server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local admin workspace origin. Keep this aligned with the admin dev server.
ADMIN_APP_URL=http://localhost:3001
NODE_ENV=development

# Cloudinary signed image-upload credentials. Keep all of these server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative to signed uploads; use this only with a restricted preset.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=veltrix/avatars

# Optional locally. Required for shared rate limiting in multi-instance production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
