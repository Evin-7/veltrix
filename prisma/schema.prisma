generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum GameStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum GameCategory {
  SLOTS
  TABLE_GAMES
  LIVE_STYLE
  BLACKJACK
  ROULETTE
  ARCADE
}

enum WalletTransactionType {
  WELCOME_BONUS
  DAILY_REWARD
  GAME_WAGER
  GAME_WIN
  ADMIN_ADJUSTMENT
  PROMOTION_REWARD
  VIP_REWARD
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum VipLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum RewardHistoryType {
  DAILY_REWARD
  PROMOTION_REWARD
  VIP_MILESTONE
}

enum NotificationType {
  REWARD
  PROMOTION
  ACCOUNT
  RESPONSIBLE_GAMING
  SYSTEM
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum GameRoundStatus {
  PENDING
  ACTIVE
  SETTLED
  CANCELLED
}

enum GameType {
  SLOTS
  BLACKJACK
  ROULETTE
  BACCARAT
  DICE
  ARCADE
}

enum GameActionType {
  SLOT_SPIN
  ROULETTE_SPIN
  BLACKJACK_DEAL
  BLACKJACK_HIT
  BLACKJACK_STAND
  BLACKJACK_DOUBLE
  BACCARAT_DEAL
  DICE_ROLL
  ARCADE_RUN
}

model User {
  id                 String                    @id @default(uuid()) @db.Uuid
  email              String                    @unique @db.VarChar(320)
  passwordHash       String?                   @db.VarChar(255)
  role               Role                      @default(PLAYER)
  status             UserStatus                @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  lastLoginAt        DateTime?
  profile            Profile?
  sessions           AuthSession[]
  oauthAccounts      OAuthAccount[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  favourites         Favourite[]
  recentGames        RecentGame[]
  gameSessions       GameSession[]
  gameRounds         GameRound[]
  gameActions        GameAction[]
  auditLogs          AuditLog[]
  createdPromotions  Promotion[]               @relation("PromotionCreatedBy")
  promotionClaims    PromotionClaim[]
  progression        PlayerProgression?
  xpEvents           XpEvent[]
  rewardHistory      RewardHistory[]
  responsibleGaming  ResponsibleGamingSetting?
  notifications      Notification[]

  @@index([status])
  @@index([role])
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  username    String   @unique @db.VarChar(32)
  displayName String?  @db.VarChar(80)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(32)
  providerAccountId String   @db.VarChar(255)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model GameProvider {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique @db.VarChar(80)
  slug      String         @unique @db.VarChar(80)
  status    ProviderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  games     Game[]

  @@index([status])
}

model Game {
  id           String        @id @default(uuid()) @db.Uuid
  providerId   String        @db.Uuid
  name         String        @db.VarChar(120)
  slug         String        @unique @db.VarChar(120)
  description  String        @db.VarChar(500)
  category     GameCategory
  thumbnail    String?
  status       GameStatus    @default(ACTIVE)
  featured     Boolean       @default(false)
  newGame      Boolean       @default(false)
  popular      Boolean       @default(false)
  demoRtp      Decimal       @db.Decimal(5, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  provider     GameProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  favourites   Favourite[]
  recentGames  RecentGame[]
  gameSessions GameSession[]
  gameRounds   GameRound[]

  @@index([providerId])
  @@index([status, category])
  @@index([status, featured])
  @@index([status, popular])
  @@index([status, newGame])
}

model GameSession {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  gameId       String            @db.Uuid
  status       GameSessionStatus @default(ACTIVE)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  totalWagered Int               @default(0)
  totalWon     Int               @default(0)
  roundCount   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  rounds       GameRound[]
  actions      GameAction[]

  @@index([userId, status, updatedAt])
  @@index([gameId, status, updatedAt])
  @@index([userId, createdAt])
}

model GameRound {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  gameId      String          @db.Uuid
  userId      String          @db.Uuid
  roundNumber Int
  status      GameRoundStatus @default(PENDING)
  wager       Int
  payout      Int             @default(0)
  netResult   Int             @default(0)
  gameType    GameType
  state       Json?
  result      Json?
  createdAt   DateTime        @default(now())
  settledAt   DateTime?
  session     GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions     GameAction[]

  @@unique([sessionId, roundNumber])
  @@index([userId, createdAt])
  @@index([userId, gameType, createdAt])
  @@index([sessionId, status])
}

model GameAction {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @db.Uuid
  roundId        String         @db.Uuid
  userId         String         @db.Uuid
  type           GameActionType
  idempotencyKey String         @unique @db.VarChar(160)
  requestHash    String         @db.VarChar(64)
  response       Json
  createdAt      DateTime       @default(now())
  session        GameSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round          GameRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roundId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([balance])
}

model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  walletId       String                @db.Uuid
  userId         String                @db.Uuid
  type           WalletTransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  referenceId    String?               @db.VarChar(160)
  idempotencyKey String?               @unique @db.VarChar(160)
  metadata       Json?
  createdAt      DateTime              @default(now())
  wallet         Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  RewardHistory  RewardHistory?

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([referenceId])
}

model Favourite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  gameId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
  @@index([gameId])
}

model RecentGame {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  gameId       String   @db.Uuid
  lastPlayedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, lastPlayedAt])
  @@index([gameId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @db.Uuid
  action         String   @db.VarChar(80)
  targetType     String   @db.VarChar(40)
  targetId       String?  @db.VarChar(160)
  idempotencyKey String?  @unique @db.VarChar(160)
  metadata       Json?
  createdAt      DateTime @default(now())
  actor          User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Promotion {
  id          String           @id @default(uuid()) @db.Uuid
  title       String           @db.VarChar(160)
  slug        String           @unique @db.VarChar(160)
  description String           @db.VarChar(1000)
  banner      Json?
  startAt     DateTime
  endAt       DateTime
  status      PromotionStatus  @default(DRAFT)
  rewardVC    Int
  eligibility Json?
  createdById String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  claims      PromotionClaim[]
  rewards     RewardHistory[]

  @@index([status, startAt, endAt])
  @@index([createdById, createdAt])
}

model PromotionClaim {
  id                  String    @id @default(uuid()) @db.Uuid
  promotionId         String    @db.Uuid
  userId              String    @db.Uuid
  rewardVC            Int
  walletTransactionId String?   @unique @db.Uuid
  idempotencyKey      String    @unique @db.VarChar(160)
  claimedAt           DateTime  @default(now())
  promotion           Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId])
  @@index([userId, claimedAt])
  @@index([promotionId, claimedAt])
}

model VipLevelConfig {
  level       VipLevel @id
  xpThreshold Int
  rewardVC    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlayerProgression {
  userId    String   @id @db.Uuid
  level     VipLevel @default(BRONZE)
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, xp])
}

model XpEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  sourceType String   @db.VarChar(40)
  sourceId   String   @db.VarChar(160)
  amount     Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
}

model RewardHistory {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  type                RewardHistoryType
  amountVC            Int                @default(0)
  level               VipLevel?
  promotionId         String?            @db.Uuid
  walletTransactionId String?            @unique @db.Uuid
  sourceKey           String             @unique @db.VarChar(200)
  metadata            Json?
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion           Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([promotionId])
}

model ResponsibleGamingSetting {
  userId                 String    @id @db.Uuid
  sessionReminderMinutes Int       @default(30)
  dailyWagerLimit        Int?
  maxWager               Int?
  coolOffUntil           DateTime?
  selfExcludedUntil      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coolOffUntil])
  @@index([selfExcludedUntil])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  message   String           @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}
